# Apache / 宝塔 Apache / 虚拟主机：伪静态与目录保护
# 没有 mod_rewrite 时系统仍可用 index.php?s=/ 兼容地址访问（后台 系统设置 → 安全 → URL 模式 选“兼容”）
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:core|data(?:_[0-9a-fA-F]+)?)(?:/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?s=/$1 [L,QSA]
</IfModule>
